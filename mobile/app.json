{
  "expo": {
    "name": "GoBarber",
    "slug": "gobarber",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "gobarber",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00ACC2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gobarber.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Allow GoBarber to add appointments to your calendar",
        "NSPhotoLibraryUsageDescription": "Allow GoBarber to access photos for business logo"
      }
    },
    "android": {
      "package": "com.gobarber.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00ACC2"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow GoBarber to add appointments to your calendar"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GoBarber to access photos for business logo"
        }
      ]
    ]
  }
}
